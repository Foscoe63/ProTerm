      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "fast-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "fast-filesystem-mcp",
        "/Users/ewg/CodingDocs",
        "/Users/ewg",
        "/Volumes/Storage",
        "/"
      ]
    },
    "prompt-optimizer": {
      "command": "python3.10",
      "args": [
        "/Volumes/AppsX/MCP-SERVERS-2/mcp-prompt-optimizer/prompt_optimizer.py"
